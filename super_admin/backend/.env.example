# Configure each Vercel environment separately. Never commit actual secret values.
LICENSE_DATABASE_URL=postgresql+psycopg://licensing:URL_ENCODED_PASSWORD@MANAGED_HOST/licensing?sslmode=require
LICENSE_SIGNING_KEY_PEM_B64=BASE64_ENCODED_ED25519_PRIVATE_PEM_SERVER_ONLY
LICENSE_SECRET_PEPPER=RANDOM_STABLE_SECRET_AT_LEAST_32_CHARACTERS
LICENSE_KEY_ID=primary
LICENSE_ADMIN_ORIGIN=https://licenses.your-domain.example
LICENSE_DEPLOYMENT_ENV=production
LICENSE_ONLINE_THRESHOLD_SECONDS=900

# Preview only: use an empty managed test database/branch, separate pepper/key/admin.
# Vercel injects VERCEL=1, VERCEL_ENV=preview and VERCEL_URL automatically.
# LICENSE_DEPLOYMENT_ENV=preview
# LICENSE_DATABASE_ID=preview_branch_id
# LICENSE_PRODUCTION_DATABASE_ID=production_branch_id
# LICENSE_PRODUCTION_DATABASE_HOST=production_database_hostname
# LICENSE_PRODUCTION_DATABASE_NAME=production_database_name
# LICENSE_KEY_ID=preview-key
# LICENSE_PRODUCTION_KEY_ID=primary
# LICENSE_PRODUCTION_SIGNING_KEY_SHA256=SHA256_OF_PRODUCTION_RAW_ED25519_PUBLIC_KEY
# Leave LICENSE_ADMIN_ORIGIN unset in preview to use that deployment's VERCEL_URL.
