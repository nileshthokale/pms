# Allowlist: upload only the licensing service and Super Admin deployment code.
/*
!/license_server/
!/licensing/
!/super_admin/
!/pyproject.toml
!/vercel.json
!/.vercelignore
/license_server/*
!/license_server/__init__.py
!/license_server/app.py
!/license_server/models.py
!/license_server/security.py
!/license_server/settings.py
!/license_server/requirements.txt
/licensing/*
!/licensing/__init__.py
!/licensing/protocol.py
/super_admin/*
!/super_admin/__init__.py
!/super_admin/backend/
!/super_admin/frontend/
/super_admin/backend/*
!/super_admin/backend/__init__.py
!/super_admin/backend/app.py
!/super_admin/backend/routes.py
!/super_admin/backend/build_frontend.py
/super_admin/frontend/*
!/super_admin/frontend/index.html
!/super_admin/frontend/login.html
!/super_admin/frontend/dashboard.js
!/super_admin/frontend/login.js
!/super_admin/frontend/style.css
!/super_admin/frontend/network.js
!/super_admin/frontend/three.module.min.js
!/super_admin/frontend/THREE-LICENSE.txt
**/__pycache__/**
**/*.pyc
**/*.db
**/*.db-*
**/*.sqlite3
**/*.pem
**/*.key
**/.env*
